apiVersion: v1
kind: Secret
metadata:
  name: example-creds
  namespace: crossplane-system
type: Opaque
stringData:
  # api_base and api_key are required. insecure_skip_verify and
  # litellm_changed_by are optional; all values must be JSON strings.
  credentials: |
    {
      "api_base": "https://litellm.example.com",
      "api_key": "sk-1234567890"
    }
